# n8n dashboard webhook (used for dashboard data, emails fallback, and news fallback)
VITE_N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/your-webhook-id

# Google OAuth client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OpenWeatherMap API key (free tier works)
VITE_OWM_KEY=your-owm-api-key

# Groq API key — powers the AI chatbot + news summaries (https://console.groq.com — free)
# If missing, the assistant shows "AI assistant unavailable".
VITE_GROQ_API_KEY=

# GNews API key — powers the live news ticker (https://gnews.io — free tier: 100 req/day)
# If missing, the ticker falls back to n8n news.
VITE_GNEWS_API_KEY=
